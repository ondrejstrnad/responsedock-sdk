{
  "name": "responsedock-sdk",
  "private": true,
  "description": "Workspace for the public ResponseDock browser and React SDKs.",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @responsedock/sdk-browser build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:ci": "node --test scripts/*.test.mjs",
    "lint": "eslint .",
    "package:check": "pnpm --filter @responsedock/sdk-browser package:check",
    "preflight": "pnpm build && node scripts/sdk-publish-preflight.mjs --out .tarballs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "clean": "pnpm -r clean && rm -rf .tarballs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
