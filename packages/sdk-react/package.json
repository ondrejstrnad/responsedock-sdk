{
  "name": "@responsedock/sdk-react",
  "version": "0.2.0",
  "description": "React bindings for the ResponseDock browser survey SDK.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ondrejstrnad/responsedock-sdk.git",
    "directory": "packages/sdk-react"
  },
  "homepage": "https://github.com/ondrejstrnad/responsedock-sdk/tree/main/packages/sdk-react#readme",
  "bugs": {
    "url": "https://github.com/ondrejstrnad/responsedock-sdk/issues"
  },
  "keywords": [
    "react",
    "survey",
    "feedback",
    "embed",
    "responsedock"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@responsedock/sdk-browser": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
