{
  "name": "@responsedock/sdk-browser",
  "version": "0.2.0",
  "description": "Browser SDK for embedding and triggering ResponseDock surveys.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ondrejstrnad/responsedock-sdk.git",
    "directory": "packages/sdk-browser"
  },
  "homepage": "https://github.com/ondrejstrnad/responsedock-sdk/tree/main/packages/sdk-browser#readme",
  "bugs": {
    "url": "https://github.com/ondrejstrnad/responsedock-sdk/issues"
  },
  "keywords": [
    "survey",
    "feedback",
    "embed",
    "responsedock"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/responsedock.global.js",
  "jsdelivr": "./dist/responsedock.global.js",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/responsedock.global.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./global": "./dist/responsedock.global.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && node scripts/build-global.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "package:check": "pnpm clean && pnpm build && node ../../scripts/sdk-package-preflight.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
